# Dedicated image for batch training jobs (run on K8s as a Job or CronJob)
# Slightly heavier than serving image since it needs full data pipeline.

FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential gcc g++ libgomp1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY src ./src
COPY configs ./configs

RUN mkdir -p artifacts data/raw data/processed mlruns

CMD ["python", "-m", "src.pipelines.train", "--artifacts", "/app/artifacts"]
